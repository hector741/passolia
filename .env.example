# Ambiente da aplicação. development | test | staging | production
# Produção exige as variáveis marcadas como obrigatórias nesse ambiente.
APP_ENV=development
APP_URL=http://localhost:3000

# Supabase local. Não aponte estes comandos para um projeto remoto.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor. Nunca usar prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Provedor de sugestões: OpenAI, só no servidor. Sem a chave, o caminho manual continua.
# Não usar prefixo NEXT_PUBLIC_. Troque o modelo se a conta não tiver este nome.
AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-astra

# Protege a rota de prontidão e, depois, o worker. Mínimo recomendado: 16 caracteres.
WORKER_AUTH_SECRET=

# Flags de módulo. Só o valor true liga. Em produção começam desligadas.
FEATURE_FINANCE=false
FEATURE_COLLABORATION=false
FEATURE_RELATIONSHIPS=false
FEATURE_WARDROBE=false
FEATURE_MULTIMODAL=false
FEATURE_INTEGRATIONS=false
FEATURE_BILLING=false
FEATURE_EXPERIMENTS=false
